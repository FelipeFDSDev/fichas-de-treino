{
  "name": "treino-fichas",
  "version": "1.0.0",
  "description": "Gerador de fichas de treino com pipeline CI/CD completa",
  "main": "src/index.html",
  "scripts": {
    "start": "live-server src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/css/js/**/*.js\"",
    "lint:fix": "eslint \"src/css/js/**/*.js\" --fix",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "format": "prettier --write src/**/*.{js,css,html}",
    "build": "npm run lint && npm run test && npm run minify",
    "minify": "node scripts/minify.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d src"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.4.0",
    "gh-pages": "^6.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "live-server": "^1.2.2",
    "prettier": "^3.0.3",
    "terser": "^5.20.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "src/css/js/**/*.js",
      "!src/css/js/**/*.test.js"
    ],
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seu-usuario/treino-fichas.git"
  },
  "keywords": [
    "treino",
    "fichas",
    "workout",
    "ci/cd",
    "github-actions"
  ],
  "author": "Seu Nome",
  "license": "MIT"
}